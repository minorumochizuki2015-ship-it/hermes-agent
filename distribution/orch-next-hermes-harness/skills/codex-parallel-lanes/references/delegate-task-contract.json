{
  "contract": "hermes_delegate_task.v1",
  "execution_target": "hermes_delegate_task",
  "delegate_task_arguments": [
    "tasks"
  ],
  "delegate_task_item_arguments": [
    "goal",
    "context",
    "role",
    "target_revision",
    "timeout_seconds"
  ],
  "controller_role": "orchestrator",
  "worker_role": "leaf",
  "target": "required_exact_task_target",
  "target_revision": "required_fixed_revision",
  "read_manifest": "required_nonempty_paths",
  "write_manifest": "required_disjoint_owned_paths_or_empty",
  "constraint_enforcement": {
    "target_revision": "runtime_validated_prompt_binding_not_checkout_enforcement",
    "timeout_seconds": "delegate_task_runtime_argument",
    "read_manifest": "prompt_constraint_only",
    "write_manifest": "prompt_constraint_only_not_capability_enforcement",
    "return_contract": "prompt_constraint_only"
  },
  "return_contract": {
    "terminal_class": "completed|blocked|intentional_stop|crash",
    "source_revision": "required",
    "changed_files": "required_array",
    "checks": "required_array",
    "blockers": "required_array",
    "nonclaims": "required_array"
  },
  "ended_session_recovery": {
    "registered_resume_surfaces": [
      "gateway:/resume",
      "cli:hermes --resume"
    ],
    "sequence": [
      "registered_resume_surface",
      "delegate_task_atomic_successor"
    ],
    "reconnect": {
      "status": "runtime_integration_dependency",
      "code": "hermes_reconnect_unavailable",
      "launch": false
    },
    "max_successors": 1,
    "successor_limit_enforcement": "prompt_constraint_only",
    "user_relay": false
  },
  "dispatcher_mutation": "prompt_constraint_only",
  "worker_mutation_scope": "prompt_write_manifest_only_not_capability_enforcement",
  "maestro_codex_execution_fallback": false,
  "external_authority_reused": false,
  "authority_unavailable": {
    "code": "maestro_authority_unavailable",
    "launch": false
  }
}
